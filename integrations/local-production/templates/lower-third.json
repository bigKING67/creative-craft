{
  "schema_version": "creative-craft.graphic-template.v1",
  "id": "lower-third",
  "version": 1,
  "description": "Name/role strap in the lower-left safe area: accent bar, title and optional subtitle on a dark plate.",
  "box": { "left": 0.06, "top": 0.7, "width": 0.62, "height": 0.2 },
  "vars": {
    "title": { "type": "string", "max_length": 16, "font_em": 3.6, "weight": 700 },
    "subtitle": { "type": "string", "max_length": 24, "font_em": 2.4, "weight": 400, "optional": true },
    "accent": { "type": "color", "optional": true, "default": "#e3b341" }
  },
  "html": "<span class=\"gfx-lower-third-plate\"><span class=\"gfx-lower-third-bar\"></span><span class=\"gfx-lower-third-text\"><span class=\"gfx-lower-third-title\">{{title}}</span><span class=\"gfx-lower-third-subtitle\">{{subtitle}}</span></span></span>",
  "css": ".gfx-lower-third{display:flex;align-items:flex-end;justify-content:flex-start}.gfx-lower-third-plate{display:flex;align-items:stretch;max-width:100%;background:rgba(12,16,22,.82);border-radius:.4em;overflow:hidden}.gfx-lower-third-bar{flex:0 0 .7em;background:var(--accent)}.gfx-lower-third-text{display:flex;flex-direction:column;padding:1em 1.6em 1em 1.2em;min-width:0}.gfx-lower-third-title{font-size:3.6em;font-weight:700;line-height:1.2;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gfx-lower-third-subtitle{font-size:2.4em;font-weight:400;line-height:1.25;color:#d7dde4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gfx-lower-third-subtitle:empty{display:none}"
}
